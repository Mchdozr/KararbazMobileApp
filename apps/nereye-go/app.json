{
  "expo": {
    "name": "Nereye",
    "slug": "nereye-go",
    "owner": "mchdozr",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nereyego",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Yakınındaki mekanları önermek için konumunu kullanırız."
      }
    },
    "android": {
      "package": "com.mchdozr.nereye",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#f4dfbf",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#f4dfbf"
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Yakınındaki mekanları önermek için konumunu kullanırız."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Profil fotoğrafın için galeriye bakarız.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0b5d45"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "95d89009-88a8-47b6-95f9-32bc87fd83cd"
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
