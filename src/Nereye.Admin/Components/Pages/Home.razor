@page "/"
@attribute [Authorize(Roles = Nereye.Application.RoleNames.Admin)]
@rendermode InteractiveServer
@inject IAdminService Admin
@inject IConfiguration Config

<h1>Şikayetler</h1>

@if (_reports is null)
{
    <p>Yükleniyor…</p>
}
else if (_reports.Count == 0)
{
    <p class="text-muted">Açık şikayet yok.</p>
}
else
{
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Tarih</th>
                <th>Neden</th>
                <th>Yorum</th>
                <th>Fotoğraf</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in _reports)
            {
                <tr>
                    <td>@r.CreatedAt.ToLocalTime().ToString("g")</td>
                    <td>@r.Reason</td>
                    <td>@(r.ReviewId?.ToString("N")[..8] ?? "—")</td>
                    <td>
                        @if (r.PhotoUrl is not null)
                        {
                            @if (_apiBase is not null)
                            {
                                <a href="@(_apiBase + r.PhotoUrl)" target="_blank" rel="noopener">
                                    <img src="@(_apiBase + r.PhotoUrl)" alt="Şikayet edilen fotoğraf" style="height:56px;border-radius:6px" />
                                </a>
                            }
                            else
                            {
                                <code>@r.PhotoUrl</code>
                            }
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </td>
                    <td>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => Resolve(r.Id, false)">Kapat</button>
                        @if (r.PhotoUrl is not null)
                        {
                            <button class="btn btn-sm btn-danger" @onclick="() => Resolve(r.Id, true)">Fotoğrafı sil + kapat</button>
                        }
                        else if (r.ReviewId is not null)
                        {
                            <button class="btn btn-sm btn-danger" @onclick="() => Resolve(r.Id, true)">Gizle + kapat</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<ReportAdminDto>? _reports;

    // Fotoğraflar API hostunda durur. Adres verilmezse yalnızca yol yazılır (tarayıcıda açılamaz).
    private string? _apiBase => Config["Api:PublicBaseUrl"]?.Trim().TrimEnd('/') is { Length: > 0 } b ? b : null;

    protected override async Task OnInitializedAsync() =>
        _reports = await Admin.ListReportsAsync(true);

    private async Task Resolve(Guid id, bool hide)
    {
        await Admin.ResolveReportAsync(id, hide);
        _reports = await Admin.ListReportsAsync(true);
    }
}
